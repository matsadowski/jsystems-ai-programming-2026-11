# Copy to app/.env and fill in. Never commit app/.env. Variables: ADR 000 §7 and ADR 004 §9.
# No variable uses the NEXT_PUBLIC_ prefix (PRD AC-38).

# Required
OPENROUTER_API_KEY=
VISION_MODEL=openai/gpt-6-luna
DECISION_MODEL=openai/gpt-6-luna

# Optional (defaults shown)
DECISION_REASONING_EFFORT=medium
CHAT_REASONING_EFFORT=low
POLICY_DIR=../docs/policies
CASE_TTL_MINUTES=120
CASE_STORE_MAX=200
APP_TIMEZONE=Europe/Warsaw

# Confidence-gated decisions (ADR 004)
DECISION_MODE=llm_only
LUNA_MODEL=openai/gpt-6-luna-decisions
LUNA_CONFIDENCE_THRESHOLD=0.80
LUNA_TIMEOUT_MS=5000

# Eval budget (ADR 002 §6.3, amendment A4)
EVAL_MAX_COST_USD=5
