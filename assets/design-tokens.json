{
  "$meta": {
    "source": "https://www.aliorbank.pl/",
    "extractedAt": "2026-11-25",
    "method": "Playwright CLI (headed Chrome), computed styles of visible elements, desktop viewport ~1025px",
    "notes": "error/success colors were not observed on the homepage and are intentionally not defined."
  },
  "colors": {
    "brand": {
      "primary": "#79003C",
      "primaryDark": "#470023",
      "primaryBright": "#A30051",
      "accent": "#FFC426",
      "accentText": "#FFC326"
    },
    "tint": {
      "pink": "#FFE5F2",
      "pinkSubtle": "#FBF3F7"
    },
    "background": {
      "default": "#FFFFFF",
      "light": "#F7F7F8",
      "footer": "#470023",
      "overlay": "rgba(0, 0, 0, 0.5)",
      "overlayStrong": "rgba(0, 0, 0, 0.65)",
      "glassOnImage": "rgba(255, 255, 255, 0.4)"
    },
    "text": {
      "primary": "#000000",
      "secondary": "#383842",
      "muted": "#5E5E6E",
      "brand": "#79003C",
      "onDark": "#FFFFFF",
      "onAccent": "#000000"
    },
    "border": {
      "default": "#DEDEE3",
      "brand": "#79003C",
      "pink": "#FFE5F2",
      "neutralStrong": "#868698"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "\"Nunito Sans\", sans-serif"
    },
    "fontFiles": {
      "normal": "assets/fonts/nunito-sans/NunitoSans-VariableFont.woff2",
      "italic": "assets/fonts/nunito-sans/NunitoSans-Italic-VariableFont.woff2",
      "weightRange": "200 1000"
    },
    "fontWeights": {
      "regular": 400,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    },
    "fontSize": {
      "sm": "14px",
      "base": "16px",
      "md": "18px",
      "lg": "20px",
      "xl": "24px",
      "2xl": "36px",
      "3xl": "48px"
    },
    "lineHeight": {
      "sm": "22px",
      "base": "24px",
      "md": "28px",
      "xl": "32px",
      "2xl": "44px",
      "3xl": "56px"
    },
    "textStyles": {
      "display": { "fontSize": "48px", "lineHeight": "56px", "fontWeight": 900 },
      "sectionTitle": { "fontSize": "36px", "lineHeight": "44px", "fontWeight": 800 },
      "cardTitle": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": 700 },
      "title": { "fontSize": "20px", "lineHeight": "28px", "fontWeight": 700 },
      "lead": { "fontSize": "24px", "lineHeight": "32px", "fontWeight": 400 },
      "bodyLarge": { "fontSize": "18px", "lineHeight": "28px", "fontWeight": 400 },
      "body": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400 },
      "bodyStrong": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 700 },
      "nav": { "fontSize": "16px", "lineHeight": "28px", "fontWeight": 600 },
      "label": { "fontSize": "14px", "lineHeight": "22px", "fontWeight": 600 }
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px"
  },
  "layout": {
    "containerWidth": "1040px",
    "stickyHeaderHeight": "96px"
  },
  "borderRadius": {
    "none": "0px",
    "xs": "6px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "full": "999px",
    "circle": "50%"
  },
  "shadow": {
    "card": "0px 8px 30px 0px rgba(7, 7, 7, 0.08)"
  },
  "components": {
    "button": {
      "primary": {
        "backgroundColor": "#79003C",
        "color": "#FFFFFF",
        "border": "2px solid #79003C",
        "padding": "14px 48px",
        "borderRadius": "16px",
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 700,
        "height": "60px"
      },
      "secondary": {
        "backgroundColor": "transparent",
        "color": "#79003C",
        "border": "2px solid #79003C",
        "padding": "14px 48px",
        "borderRadius": "16px",
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 700,
        "height": "60px"
      },
      "small": {
        "backgroundColor": "#79003C",
        "color": "#FFFFFF",
        "border": "2px solid #79003C",
        "padding": "8px 24px",
        "borderRadius": "16px",
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 700,
        "height": "44px"
      }
    },
    "tag": {
      "recommended": {
        "backgroundColor": "#FFC426",
        "color": "#000000",
        "padding": "8px 16px",
        "borderRadius": "999px",
        "fontSize": "14px",
        "lineHeight": "22px",
        "fontWeight": 600,
        "textTransform": "uppercase"
      },
      "promo": {
        "backgroundColor": "#FFE5F2",
        "color": "#000000",
        "border": "1px solid #FFE5F2",
        "padding": "8px 16px",
        "borderRadius": "999px",
        "fontSize": "14px",
        "lineHeight": "22px",
        "fontWeight": 600,
        "textTransform": "uppercase"
      }
    },
    "card": {
      "backgroundColor": "#FFFFFF",
      "borderRadius": "16px",
      "boxShadow": "0px 8px 30px 0px rgba(7, 7, 7, 0.08)"
    },
    "header": {
      "backgroundColor": "#F7F7F8",
      "position": "sticky",
      "height": "96px"
    },
    "nav": {
      "color": "#000000",
      "fontSize": "16px",
      "lineHeight": "28px",
      "fontWeight": 600,
      "padding": "14px 7px 14px 12px"
    },
    "input": {
      "backgroundColor": "#FFFFFF",
      "color": "#000000",
      "padding": "13px 0px",
      "fontSize": "16px",
      "height": "50px"
    },
    "footer": {
      "backgroundColor": "#470023",
      "color": "#FFFFFF",
      "padding": "64px 0px 16px"
    }
  }
}
